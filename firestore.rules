rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function courier() { return signedIn() && request.auth.token.courier == true; }

    match /products/{productId} {
      allow read: if true;
      allow write: if admin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if admin();
    }

    match /users/{uid} {
      allow read: if owns(uid) || admin();
      allow create: if owns(uid)
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly(['displayName', 'publicName', 'email', 'phone', 'avatarUrl', 'role', 'isGuest', 'rankingOptIn', 'gameRankingOptIn', 'notifications', 'createdAt', 'updatedAt']);
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'publicName', 'phone', 'rankingOptIn', 'gameRankingOptIn', 'notifications', 'avatarUrl', 'updatedAt']);
      allow update, create, delete: if admin();

      match /addresses/{addressId} {
        allow read, create, update, delete: if owns(uid);
        allow read: if admin();
      }
      match /favorites/{productId} {
        allow read, create, delete: if owns(uid);
        allow update: if false;
      }
      match /notifications/{notificationId} {
        allow read: if owns(uid);
        allow update: if owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create, delete: if false;
      }
      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if owns(uid);
      }
    }

    match /orders/{orderId} {
      allow read: if admin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (courier() && resource.data.courierId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false;
    }

    match /gameSessions/{sessionId} { allow read, write: if false; }
    match /gameScores/{uid} { allow read, write: if false; }
    match /customerStats/{uid} { allow read, write: if false; }
    match /notificationEvents/{eventId} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
